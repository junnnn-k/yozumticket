rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 헬퍼 함수 =====

    // 인증된 사용자인지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 자신의 문서인지 확인
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // 게시글 작성자인지 확인
    function isPostOwner() {
      return request.auth.uid == resource.data.userId;
    }

    // ===== Users 컬렉션 =====
    match /users/{userId} {
      // 읽기: 인증된 사용자만 가능
      allow read: if isAuthenticated();

      // 생성/수정: 본인만 가능
      allow create, update: if isAuthenticated() && isOwner(userId);

      // 삭제: 본인만 가능
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // ===== Posts 컬렉션 =====
    match /posts/{postId} {
      // 읽기 규칙
      allow read: if
        // 본인의 게시글은 항상 읽기 가능
        isPostOwner()
        // 친구 공개는 인증된 사용자 누구나 읽기 가능 (친구 관계 확인은 앱 레벨에서 처리)
        || (isAuthenticated() && resource.data.privacy == 'friends');

      // 생성 규칙
      allow create: if
        isAuthenticated()
        // 작성자 ID가 현재 사용자와 일치
        && request.resource.data.userId == request.auth.uid
        // 필수 필드 존재 확인
        && request.resource.data.keys().hasAll([
          'userId', 'ticketImageUrl', 'gameInfo', 'title',
          'privacy', 'createdAt', 'updatedAt'
        ])
        // 유효한 프라이버시 설정 (private, friends만 허용)
        && request.resource.data.privacy in ['private', 'friends']
        // mood 필드 검증 (선택적)
        && (!request.resource.data.keys().hasAny(['mood'])
            || request.resource.data.mood in ['excited', 'happy', 'normal', 'sad', 'angry']);

      // 수정 규칙
      allow update: if
        isAuthenticated()
        // 본인의 게시글만 수정 가능
        && isPostOwner()
        // userId는 변경 불가
        && request.resource.data.userId == resource.data.userId
        // 유효한 프라이버시 설정 (private, friends만 허용)
        && request.resource.data.privacy in ['private', 'friends']
        // mood 필드 검증 (선택적)
        && (!request.resource.data.keys().hasAny(['mood'])
            || request.resource.data.mood in ['excited', 'happy', 'normal', 'sad', 'angry']);

      // 삭제 규칙
      allow delete: if isAuthenticated() && isPostOwner();
    }

    // ===== SharedArchives 컬렉션 (나중에 추가) =====
    match /sharedArchives/{archiveId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ===== Friendships 컬렉션 =====
    match /friendships/{friendshipId} {
      // 읽기: 자신이 요청자 또는 수신자인 경우만
      allow read: if
        isAuthenticated() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);

      // 생성: 인증된 사용자만, 자신이 요청자인 경우만
      allow create: if
        isAuthenticated() &&
        request.resource.data.requesterId == request.auth.uid &&
        // 필수 필드 존재 확인
        request.resource.data.keys().hasAll([
          'requesterId', 'receiverId', 'status', 'createdAt'
        ]) &&
        // 초기 상태는 pending이어야 함
        request.resource.data.status == 'pending' &&
        // 자기 자신에게 친구 요청 불가
        request.resource.data.requesterId != request.resource.data.receiverId;

      // 수정: 요청자 또는 수신자만 가능
      allow update: if
        isAuthenticated() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid) &&
        // requesterId, receiverId는 변경 불가
        request.resource.data.requesterId == resource.data.requesterId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        // 상태만 변경 가능
        request.resource.data.status in ['pending', 'accepted', 'rejected', 'blocked'];

      // 삭제: 요청자 또는 수신자만 가능
      allow delete: if
        isAuthenticated() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);
    }

    // ===== 기타 모든 문서 접근 거부 =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
